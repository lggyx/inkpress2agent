# Java / Maven
server/target/
*.class
*.jar

# Node
node_modules/
.nuxt/
.output/
dist/

# Vditor 静态资产（postinstall 从 node_modules 拷贝的构建产物，勿入库）
public/vditor/

# 环境变量与密钥（禁止入库）
.env
.env.*
# distributor 本机凭据与运行产物（设备令牌/平台 Cookie 不出机）
distributor/config.json
distributor/.profiles/
distributor/.artifacts/
distributor/.auth/

# 日志与系统文件
logs/
*.log
.DS_Store
Thumbs.db

# IDE
.idea/
*.iml
.vscode/

# 本地数据卷备份与临时文件
*.dump
tmp/

# 项目内部工作目录
.workbuddy/
.zcode/
docs/perf/_tmp/
unslop/  
