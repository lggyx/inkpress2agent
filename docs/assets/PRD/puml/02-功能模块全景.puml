@startuml 02-功能模块全景
skinparam dpi 300
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam packageStyle rectangle
title InkPress 功能模块全景（17 模块 + 1 横切）

package "板块一 · 博客核心平台（任务书铁契约）" {
  rectangle "M1 认证\nJWT · 登录注册 · 会话" as M1
  rectangle "M2 文章管理\nMarkdown · 草稿/发布/置顶 · 分类标签 · 封面" as M2
  rectangle "M3 站内互动\n评论/回复 · 图片评论 · 审核 · 点赞去重 · 浏览计数" as M3
  rectangle "M4 数据统计查询\n多维筛选 · 热门排行 · 看板" as M4
}

package "板块二 · 互动与社区治理" {
  rectangle "M15 通知系统\n被回复站内提醒 · 邮件推送 · 邮箱绑定 · 退订" as M15
  rectangle "M16 权限管理\n用户管理 · 四级角色 · 操作日志 · 防锁死" as M16
  rectangle "M18 等级特权管理\nTL0-TL4 信任等级 · 能力闸 · 举报闭环 · 双轨融合" as M18
}

package "板块三 · 知识接口层（研究重点一）" {
  rectangle "M5a 检索内核 ES\nIK 分词 · BM25 · kNN · RRF" as M5
  rectangle "M5b 工具层\n搜索 / 获取 / 相关推荐" as M5b
  rectangle "M5c 双接口\n人（站内搜索）· agent（MCP stretch）" as M5c
  M5 --> M5b
  M5b --> M5c
}

package "板块四 · 预处理与辅助分发（研究重点二）" {
  rectangle "M6 AI 预处理台\n摘要/标签 · 格式转换 · 编辑器助手" as M6
  rectangle "M7 草稿填充引擎 CLI\n持久登录态 · 跳转创作页 · 注入 · 交还用户" as M7
  rectangle "M8 平台适配器 ×7\n统一机制 · 按编辑器能力分级深度" as M8
  M6 --> M7
  M7 --> M8
}

package "板块五 · 数据整合与平台安全" {
  rectangle "M9 入站审计\n文本+图片双模态 · 审核队列（平台自卫）" as M9
  rectangle "M10 发布记录与整合\n链接回填 · 主副本↔分发视图 · 发布看板" as M10
  rectangle "M12 看板与访客分析\n流量/地域 · 异常 IP 处置" as M12
  rectangle "M13 对象存储 SPI\n本地 ↔ 七牛" as M13
  rectangle "M14 机器身份授权\napi_token · scope · 签发/吊销 · 使用审计" as M14
  rectangle "M17 平台配置\nAI 服务商 · SMTP · 站点信息" as M17
}

package "板块六 · 可观测与运维" {
  rectangle "M19 日志管理\n结构化 JSON · traceId 全链路 · 查询 UI · 30 天轮转" as M19
  rectangle "M20 IP 管理\n黑/白名单 · 归属地 · 访问记录 · 封禁 · 限流规则" as M20
  rectangle "M21 健康监测\nActuator · 组件探针 · 状态页 · 降级告警" as M21
}

rectangle "M11 混合渲染（横切基础设施）\nNuxt3 ISR + 管理端 SPA + revalidate 协议" as M11

M2 --> M5 : 发布事件
M2 --> M6 : 标记待分发
M3 --> M9 : 提交内容
M3 --> M18 : 过审/获赞/举报采纳
M3 --> M15 : 回复事件
M18 --> M3 : TL3 免审分流
M8 --> M10 : 用户回填链接
M3 ..> M13 : 图片
M12 --> M20 : 异常 IP 自动候选
M19 ..> M21 : 日志与指标同源

@enduml
