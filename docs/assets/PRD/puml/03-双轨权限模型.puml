@startuml 03-双轨权限模型
skinparam dpi 300
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
title 双轨权限模型：任命角色 × 信任等级

package "轨道一 · 任命角色（管权威，人工授予）" {
  rectangle "L1 访客\n读 / 评论 / 点赞" as L1
  rectangle "L2 博主\n写作 / 管自己的文章与评论" as L2
  rectangle "L3 管理员\n审核 / 用户管理 / 博主审批 / 全站看板" as L3
  rectangle "L4 站长\n系统配置 / 授权管理 / 角色任免 / 站长让渡" as L4
  L1 --> L2
  L2 --> L3
  L3 --> L4
}

package "轨道二 · 信任等级（管行为，自动挣得）" {
  rectangle "TL0 新客\n禁外链 · 禁贴图" as T0
  rectangle "TL1 初识\n外链 · 1 图 · 可举报" as T1
  rectangle "TL2 常客\n3 图 · 编辑/删除自评" as T2
  rectangle "TL3 熟客\n免审直发 · 举报加权" as T3
  rectangle "TL4 荣誉\n站长授予" as T4
  T0 --> T1
  T1 --> T2
  T2 --> T3
  T3 --> T4
}

rectangle "有效权限 = 任命角色 ∪ 信任等级\nservice 层组合判定，两侧独立演进" as UNION

package "API 分区" {
  rectangle "/api/author/**  → L2+" as Z1
  rectangle "/api/manage/**  → L3+" as Z2
  rectangle "/api/owner/**   → L4 only" as Z3
  rectangle "/api/distribution · agent · records\n→ token + scope（机器区）" as Z4
}

rectangle "信任指标：注册天数 · 过审评论 · 获赞 · 被采纳举报\n事件驱动重算 + 每日 cron 对账" as METRICS

L4 --> UNION
T4 --> UNION
UNION --> Z1
UNION --> Z2
UNION --> Z3
METRICS --> T2

@enduml
