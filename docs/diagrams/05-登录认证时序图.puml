@startuml 05-登录认证时序图
skinparam dpi 200
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
title JWT 登录认证时序图

actor 用户 as user
participant "Vue 前端\n(Pinia/axios)" as vue
participant "AuthController" as ctrl
participant "AuthService" as svc
database "MySQL" as db
participant "JwtUtil" as jwt

== 登录 ==
user -> vue : 输入用户名/密码
vue -> ctrl : POST /api/auth/login
ctrl -> svc : login(dto)
svc -> db : 按用户名查询用户
db --> svc : User 记录
svc -> svc : BCrypt.matches(password, hash)
alt 校验通过
    svc -> jwt : generate(LoginUser)
    jwt --> svc : JWT（含 userId/username/role，有效期 7 天）
    svc --> ctrl : LoginVO(token, user)
    ctrl --> vue : ApiResponse.ok()
    vue -> vue : localStorage 保存 token\n跳转后台
else 校验失败
    svc --> ctrl : BizException(1002)
    ctrl --> vue : "用户名或密码错误"
end

== 后续受保护请求 ==
vue -> vue : 请求头携带\nAuthorization: Bearer <token>
vue -> ctrl : GET /api/admin/**
note right of ctrl
  JwtAuthFilter（OncePerRequestFilter）
  解析签名 -> 构造无状态认证主体
  失效/篡改 -> 保持未认证
end note
alt 令牌有效且角色为 ADMIN
    ctrl --> vue : 业务数据
else 令牌无效或过期
    ctrl --> vue : code=401（前端清除登录态跳转登录页）
end
@enduml
